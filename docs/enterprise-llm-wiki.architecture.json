  "cards": [
    {
      "dot": "cyan",
      "title": "核心思想",
      "items": [
        "不是每次提问都重读原始资料，而是先把资料持续编译为可维护 Wiki",
        "PostgreSQL 保存事实；Redis、关系索引和 Obsidian 都是可重建投影"
      ]
    },
    {
      "dot": "emerald",
      "title": "一致性、安全与追溯",
      "items": [
        "来源版本、页面修订、证据、审核、审计与 Outbox 形成完整证据链",
        "JWT/API Key、RBAC 与 FORCE RLS 隔离租户；已有知识更新必须审核"
      ]
    },
    {
      "dot": "violet",
      "title": "异步与容错",
      "items": [
        "数据库任务表承担可靠队列：SKIP LOCKED 分片、租约过期接管、指数退避和死信",
        "Python/LLM 网络调用不占用数据库事务；模型失败时关键链路有确定性或抽取式降级"
      ]
    }
  ]
