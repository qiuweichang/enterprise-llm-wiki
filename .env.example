# Java server
LLM_WIKI_DB_URL=jdbc:postgresql://localhost:5432/llm_wiki
LLM_WIKI_DB_USERNAME=postgres
LLM_WIKI_DB_PASSWORD=replace-me
LLM_WIKI_REDIS_HOST=127.0.0.1
LLM_WIKI_REDIS_PORT=6379
LLM_WIKI_REDIS_DATABASE=1
LLM_WIKI_REDIS_PASSWORD=replace-me
LLM_WIKI_JWT_SECRET=replace-with-at-least-32-random-characters

# Optional first-run administrator bootstrap
LLM_WIKI_BOOTSTRAP_ENABLED=true
LLM_WIKI_BOOTSTRAP_EMAIL=admin@llm-wiki.local
LLM_WIKI_BOOTSTRAP_PASSWORD=replace-me

# Independent extraction service
LLM_WIKI_PYTHON_BASE_URL=http://127.0.0.1:8101

# Optional OpenAI-compatible compiler. Without these values the server uses a deterministic extractive fallback.
LLM_WIKI_LLM_BASE_URL=
LLM_WIKI_LLM_API_KEY=
LLM_WIKI_LLM_MODEL=
# 用于加密数据库中的空间级模型 API Key；生产环境应使用独立随机秘密。
LLM_WIKI_MODEL_ENCRYPTION_KEY=
